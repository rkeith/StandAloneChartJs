## Dependencies (generated when using npm, yarn, or pnpm)
node_modules/
jspm_packages/
web_modules/

# Build & Compiled Output (created by bundlers like Vite, Webpack, Parcel)
dist/
build/
out/
.parcel-cache/
.turbo/

# Environment Variables & Secrets (NEVER commit these!)
.env
.env.local
.env.*.local
*.pem

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# IDEs, Editors & System Files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db

